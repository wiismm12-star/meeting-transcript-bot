TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Large Telegram uploads require the optional local Bot API server. Leave these
# defaults unchanged unless you run the server elsewhere.
TELEGRAM_API_BASE_URL=
TELEGRAM_LOCAL_MODE=false
TELEGRAM_LOCAL_FILE_ROOT=/var/lib/telegram-bot-api
TELEGRAM_LOCAL_FILE_HOST_ROOT=./data/telegram-bot-api
TELEGRAM_REQUEST_TIMEOUT=600
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_KEYTERMS=
GLADIA_API_KEY=
TRANSCRIBE_PROVIDER=deepgram
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh
WHISPER_INITIAL_PROMPT=
WHISPER_MODEL_DIR=./data/models/whisper
GLADIA_NUM_SPEAKERS=0
GLADIA_VOCABULARY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_TEXT_MODEL=gpt-4.1-mini
ENABLE_POLISH=true
POLISH_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen3:8b
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
ENABLE_EMAIL_DELIVERY=false
ENABLE_LINE_BOT=false
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
DATA_DIR=./data
MAX_AUDIO_MB=50
CHUNK_MAX_SECONDS=600
CHUNK_OVERLAP_SECONDS=1.5
CHUNK_MAX_WORKERS=4
MAX_CONCURRENT_JOBS=2
ENABLE_PYANNOTE_DIARIZATION=false
PYANNOTE_HF_TOKEN=
PYANNOTE_NUM_SPEAKERS=0
